{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-nonprofit",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DEMO_MODE": "false",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 13 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-nonprofit",
      "database_id": "REPLACE_WITH_YOUR_NEW_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}

# Local Node preview/bootstrap only. Cloudflare deployment uses wrangler.jsonc.
# Copy to .env; npm run dev and npm run setup:workspace load it automatically.
PORT=8787
TIDEPATH_DEMO_MODE=true
# Optional alternate existing database (or a new path during workspace bootstrap):
# TIDEPATH_DB_PATH=.local/my-nonprofit.sqlite
# For an empty workspace, set TIDEPATH_DEMO_MODE=false and run:
# npm run setup:workspace -- --local
# Setup prompts for the first manager credentials; never commit passwords.
# Optional non-secret bootstrap defaults:
# TIDEPATH_ORGANIZATION=My Nonprofit
# TIDEPATH_SERVICE_AREAS=Neighborhood One,Neighborhood Two
# TIDEPATH_QUARTER_START=2026-10-01
# TIDEPATH_QUARTER_END=2026-12-31
# TIDEPATH_WORKING_DATE=2026-11-08
